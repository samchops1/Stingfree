<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- service/macos/com.falcon.dlp.plist  ->  ~/Library/LaunchAgents/
     Load with: launchctl load ~/Library/LaunchAgents/com.falcon.dlp.plist
     LaunchAgent (per-user) for the test; use a LaunchDaemon if you want it
     running before login. -->
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.falcon.dlp</string>
    <key>ProgramArguments</key>
    <array>
      <string>/path/falcon-dlp/backend/venv/bin/uvicorn</string>
      <string>app:app</string>
      <string>--host</string>
      <string>127.0.0.1</string>
      <string>--port</string>
      <string>8765</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/path/falcon-dlp/backend</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
  </dict>
</plist>
